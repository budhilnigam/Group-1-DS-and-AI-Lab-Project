# ============================================================================
# Qdrant Vector Database Configuration
# ============================================================================
# For local Qdrant instance (Docker or standalone)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# For Qdrant Cloud, use:
# QDRANT_URL=https://your-cluster-url.qdrant.io
# QDRANT_API_KEY=your_qdrant_api_key_here
RAG_COLLECTION_NAME=guideline_embeddings

# ============================================================================
# LLM API Keys
# ============================================================================
# Groq API Key (for Groq LLM access)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_V2=your_groq_api_key_v2_here
GROQ_API_URL=https://api.groq.com

# HuggingFace API Key (optional, for model token limits)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# ============================================================================
# GitHub API Configuration (for dataset generation scripts)
# ============================================================================
GITHUB_TOKEN=your_github_token_here

# ============================================================================
# Project Settings
# ============================================================================
# Project name
PROJECT_NAME=RagBasedCodeReview

# Debug mode (True/False)
DEBUG=False

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# Embedding Model Configuration
# ============================================================================
# SentenceTransformers model to use for embeddings
RAG_EMBED_MODEL_NAME=BAAI/bge-large-en-v1.5

# Vector embedding dimension
# EMBEDDING_DIM=1024  (fixed for BAAI/bge-large-en-v1.5)


